logging {
  level  = "info"
  format = "logfmt"
}

// --------------------
// OTLP receiver
// OTLP HTTP:
//   traces → 4318
//   logs   → 4318
//   metrics → 4318
// --------------------

otelcol.receiver.otlp "default" {

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.traces.input]
    logs = [otelcol.processor.batch.logs.input]
    metrics =  [otelcol.processor.batch.metrics.input]
  }
}


// --------------------
// TRACES → TEMPO
// For Tempo, we're using the OTLP protocol.
// Tempo exposes an OTLP/HTTP receiver on 4318.
// --------------------

otelcol.processor.batch "traces" {
  output {
    traces = [otelcol.exporter.otlphttp.tempo.input]
  }
}

otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "tempo:4318"

    tls {
      insecure = true
    }
  }
}

// --------------------
// LOGS → LOKI
// Push the log data by using loki's api
// --------------------
otelcol.processor.batch "logs" {
  output {
    logs = [otelcol.exporter.loki.loki.input]
  }
}
otelcol.exporter.loki "loki" {
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}


// --------------------
// Method 1 
// METRICS → PROMETHEUS (PUSH)
// Alloy push to prometheus
// App ──> OTLP metrics PUSH ──> Alloy -> Prometheus
// --------------------

otelcol.processor.batch "metrics" {
  output {
    metrics = [otelcol.exporter.prometheus.default.input]
  }
}

otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint  {
    url = "http://prometheus:9090/api/v1/write"
  }
}




